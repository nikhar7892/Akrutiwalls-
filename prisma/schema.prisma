// Akrutiwalls MCA — Company Master schema (Phase 1: manual entry + doc upload)
// Versioning strategy: append-only history rows for capital, address, directorships,
// shareholding. The "current" view is computed as the open row (effective_to IS NULL)
// or the latest effective_from. This keeps every change auditable and supports
// point-in-time queries needed for AOC-4 / MGT-7 / past-year reporting.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Tenancy: Firms (white-label) ----------
// A Firm is one CA / CS practice using the platform. The platform operator
// (PLATFORM_ADMIN) hosts every firm; each firm sees the product under its own
// name, logo, colours, and (eventually) custom domain — clients of that firm
// only ever see the firm's branding.

model Firm {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String                                // internal name
  productName   String                                // shown to users, e.g. "Acme CA MCA"
  customDomain  String?  @unique                      // e.g. mca.acmeca.in (CNAME → platform host)
  isDefault     Boolean  @default(false)              // the platform's own / fallback firm
  isActive      Boolean  @default(true)

  // Branding
  logoUrl       String?
  faviconUrl    String?
  primaryColor  String   @default("#1f2937")          // CSS var --brand-primary
  accentColor   String   @default("#2563eb")          // CSS var --brand-accent
  supportEmail  String?
  footerText    String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  companies     Company[]

  @@index([customDomain])
}

// ---------- Identity & access ----------

enum UserRole {
  PLATFORM_ADMIN // platform operator (you)
  FIRM_ADMIN     // CA partner who runs a firm
  STAFF          // works inside a firm; can be granted memberships to its companies
  CLIENT         // external client; sees one company within a firm
  ADMIN          // DEPRECATED — kept so existing rows still load; treat as PLATFORM_ADMIN
}

enum MembershipRole {
  OWNER          // company owner (typically a client admin)
  EDITOR         // can edit master data + upload
  VIEWER         // read-only
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String
  name          String?
  role          UserRole      @default(STAFF)
  isActive      Boolean       @default(true)
  firmId        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  firm          Firm?         @relation(fields: [firmId], references: [id], onDelete: SetNull)
  memberships   Membership[]
  auditEntries  AuditLog[]
  uploads       Document[]    @relation("DocUploadedBy")

  @@index([firmId])
}

model Membership {
  id          String          @id @default(cuid())
  userId      String
  companyId   String
  role        MembershipRole  @default(VIEWER)
  createdAt   DateTime        @default(now())

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

// ---------- Company core ----------

enum CompanyClass {
  PRIVATE
  PUBLIC
  OPC
  LLP
  SECTION_8
}

enum CompanyStatus {
  ACTIVE
  DORMANT
  STRIKE_OFF
  UNDER_LIQUIDATION
  DISSOLVED
  AMALGAMATED
}

enum ListingStatus {
  UNLISTED
  LISTED
}

model Company {
  id                String          @id @default(cuid())
  firmId            String?
  cin               String          @unique
  name              String
  formerNames       String[]        @default([])
  pan               String?
  tan               String?
  gstin             String?
  udyamNumber       String?         // MSME / Udyam registration
  dpiitNumber       String?         // DPIIT / Startup India recognition
  iecNumber         String?         // Import Export Code
  rocCode           String?
  registrationNo    String?
  dateOfIncorporation DateTime?
  emailOfficial     String?
  phoneOfficial     String?
  website           String?

  companyClass      CompanyClass    @default(PRIVATE)
  status            CompanyStatus   @default(ACTIVE)
  listingStatus     ListingStatus   @default(UNLISTED)

  mainNicCode       String?
  businessNature    String?         // free text description of business

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  firm              Firm?           @relation(fields: [firmId], references: [id], onDelete: SetNull)
  memberships       Membership[]
  addresses         Address[]
  capitalHistory    CapitalHistory[]
  directorships     Directorship[]
  shareholdings    ShareholdingEntry[]
  shareholders      Shareholder[]
  documents         Document[]
  filings           Filing[]
  auditEntries      AuditLog[]

  @@index([firmId])
}

// ---------- Address (versioned) ----------

enum AddressType {
  REGISTERED
  CORPORATE
  CORRESPONDENCE
  FACTORY
  BRANCH
}

model Address {
  id            String       @id @default(cuid())
  companyId     String
  type          AddressType  @default(REGISTERED)
  line1         String
  line2         String?
  city          String
  state         String
  pin           String
  country       String       @default("India")
  email         String?
  phone         String?
  effectiveFrom DateTime
  effectiveTo   DateTime?    // null = current
  changeFiling  String?      // SRN / form reference (e.g. INC-22)
  notes         String?
  createdAt     DateTime     @default(now())

  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, type, effectiveTo])
}

// ---------- Capital (versioned) ----------

enum CapitalChangeReason {
  INITIAL
  ALLOTMENT
  BUYBACK
  BONUS
  SPLIT
  CONSOLIDATION
  REDUCTION
  CONVERSION
  OTHER
}

model CapitalHistory {
  id                  String              @id @default(cuid())
  companyId           String
  authorizedAmount    Decimal             @db.Decimal(18, 2)
  paidUpAmount        Decimal             @db.Decimal(18, 2)
  faceValue           Decimal             @db.Decimal(18, 2)
  authorizedShares    BigInt
  paidUpShares        BigInt
  effectiveFrom       DateTime
  effectiveTo         DateTime?
  changeReason        CapitalChangeReason @default(INITIAL)
  changeFiling        String?             // SH-7 / PAS-3 SRN
  notes               String?
  createdAt           DateTime            @default(now())

  company             Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, effectiveTo])
}

// ---------- Directors / KMP ----------

enum DirectorDesignation {
  DIRECTOR
  MANAGING_DIRECTOR
  WHOLE_TIME_DIRECTOR
  INDEPENDENT_DIRECTOR
  NOMINEE_DIRECTOR
  ADDITIONAL_DIRECTOR
  ALTERNATE_DIRECTOR
  CHAIRMAN
  CFO
  CS
  CEO
}

model Director {
  id           String          @id @default(cuid())
  din          String          @unique
  name         String
  pan          String?
  dob          DateTime?
  nationality  String?         @default("Indian")
  email        String?
  phone        String?
  address      String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  directorships Directorship[]
}

model Directorship {
  id                 String              @id @default(cuid())
  companyId          String
  directorId         String
  designation        DirectorDesignation @default(DIRECTOR)
  appointmentDate    DateTime
  cessationDate      DateTime?           // null = currently serving
  appointmentMode    String?             // DIR-12 SRN etc.
  cessationMode      String?
  notes              String?
  createdAt          DateTime            @default(now())

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  director           Director            @relation(fields: [directorId], references: [id], onDelete: Restrict)

  @@unique([companyId, directorId, appointmentDate])
  @@index([companyId, cessationDate])
}

// ---------- Shareholders / Cap table ----------

enum ShareholderType {
  INDIVIDUAL
  BODY_CORPORATE
  HUF
  FOREIGN_INDIVIDUAL
  FOREIGN_CORPORATE
  TRUST
  GOVERNMENT
}

enum ShareClass {
  EQUITY
  PREFERENCE
  CCPS              // compulsorily convertible preference
  OCPS              // optionally convertible preference
}

enum ShareTransactionType {
  ALLOTMENT
  TRANSFER_IN
  TRANSFER_OUT
  BUYBACK
  BONUS
  SPLIT
  CONVERSION
  OPENING_BALANCE
}

model Shareholder {
  id           String              @id @default(cuid())
  companyId    String
  name         String
  pan          String?
  folio        String?
  type         ShareholderType     @default(INDIVIDUAL)
  nationality  String?             @default("Indian")
  address      String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entries      ShareholdingEntry[]

  @@index([companyId])
  @@index([companyId, pan])
}

// Append-only ledger of share movements; cap table at any date is the
// running sum of (shareholderId, shareClass) up to that date.
model ShareholdingEntry {
  id              String                @id @default(cuid())
  companyId       String
  shareholderId   String
  shareClass      ShareClass            @default(EQUITY)
  transactionType ShareTransactionType
  numberOfShares  BigInt                // positive for inflow, negative for outflow
  faceValue       Decimal               @db.Decimal(18, 2)
  premium         Decimal?              @db.Decimal(18, 2)
  asOfDate        DateTime
  filingReference String?               // PAS-3 / SH-4 etc.
  notes           String?
  createdAt       DateTime              @default(now())

  company         Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shareholder     Shareholder           @relation(fields: [shareholderId], references: [id], onDelete: Restrict)

  @@index([companyId, asOfDate])
  @@index([companyId, shareholderId, shareClass])
}

// ---------- Documents ----------

enum DocumentCategory {
  MASTER            // one-time / forever (MOA, AOA, CIN, PAN, TAN, GST cert, board seal)
  YEARLY            // FY-tagged (ITR, audited financials, AOC-4, MGT-7, DIR-3 KYC, board report, AGM minutes)
  FILING            // attachments to a specific filing/SRN
  OTHER
}

enum DocumentType {
  // Master
  CIN_CERTIFICATE
  MOA
  AOA
  PAN_CARD
  TAN_CERTIFICATE
  GST_CERTIFICATE
  COMMON_SEAL
  REGISTERED_OFFICE_PROOF
  BOARD_RESOLUTION

  // Yearly
  ITR
  FINANCIALS_AUDITED
  FINANCIALS_PROVISIONAL
  AOC_4
  MGT_7
  MGT_7A
  DIR_3_KYC
  BOARD_REPORT
  AGM_MINUTES
  SIGNIFICANT_NOTES
  AUDITORS_REPORT

  // Filing
  FORM_INC_22
  FORM_DIR_12
  FORM_SH_7
  FORM_PAS_3
  FORM_MGT_14
  CHALLAN

  OTHER
}

model Document {
  id              String                @id @default(cuid())
  companyId       String
  category        DocumentCategory
  docType         DocumentType
  title           String
  fy              String?               // e.g. "2023-24" for yearly docs
  storageKey      String                // path or S3 key
  mimeType        String?
  sizeBytes       Int?
  checksum        String?
  uploadedById    String
  source          String                @default("manual") // manual | parsed | imported
  parsedPayload   Json?                 // future: extracted fields from parser
  version         Int                   @default(1)
  notes           String?
  createdAt       DateTime              @default(now())

  // Optional link to a Filing (when this doc is the form PDF / challan / supporting attachment)
  filingId        String?
  attachmentRole  FilingAttachmentRole?

  company         Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy      User                  @relation("DocUploadedBy", fields: [uploadedById], references: [id])
  filing          Filing?               @relation("FilingAttachments", fields: [filingId], references: [id], onDelete: SetNull)

  @@index([companyId, category])
  @@index([companyId, docType, fy])
  @@index([filingId])
}

// ---------- Filings log ----------

enum FilingStatus {
  PENDING
  FILED
  APPROVED
  REJECTED
  RESUBMITTED
}

enum FilingAttachmentRole {
  FORM         // the signed/uploaded form PDF itself
  CHALLAN      // payment challan / receipt
  OTHER        // any supporting attachment
}

model Filing {
  id            String        @id @default(cuid())
  companyId     String
  form          String        // e.g. INC-22, DIR-12, SH-7, PAS-3, AOC-4, MGT-7
  srn           String?
  purpose       String?       // free-text purpose of the form
  amountPaid    Decimal?      @db.Decimal(18, 2)
  fy            String?
  filedOn       DateTime?
  status        FilingStatus  @default(PENDING)
  remarks       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  attachments   Document[]    @relation("FilingAttachments")

  @@index([companyId, form])
  @@index([companyId, srn])
}

// ---------- Audit log ----------

// ===========================================================================
// Stage 1 — Parser-Spec Normalised Schema
// ---------------------------------------------------------------------------
// Source of truth: project report 'Parser Specification — Indian Company &
// Statutory Documents' (research date 14 May 2026), section 'Consolidated
// Master Schema'. Every column name and PK below is taken verbatim from the
// report. Physical table names use a 'parser_' prefix (set via @@map) to
// avoid collision with the existing application tables; the report's logical
// names (`company`, `directors_kmp`, `auditors`, ...) are preserved in the
// trailing segment of each @@map and in this schema's structure.
//
// Identifier formats are validated by Postgres CHECK constraints added in
// the migration SQL — see prisma/migrations/.../migration.sql for the
// regex strings (also kept verbatim from the report's identifier table).
// ===========================================================================

model ParserCompany {
  // PK = cin (per report). PAN cross-validated separately (hard-fail rule).
  cin                              String   @id
  pan                              String?
  tan                              String?
  legal_name                       String   @map("legal_name")
  former_names                     String[] @default([]) @map("former_names")
  date_of_incorporation            DateTime? @map("date_of_incorporation") @db.Date
  roc_jurisdiction                 String?  @map("roc_jurisdiction")
  company_category                 String?  @map("company_category")
  company_sub_category             String?  @map("company_sub_category")
  listing_status                   String?  @map("listing_status")
  company_status                   String?  @map("company_status")
  registered_office_address        String?  @map("registered_office_address")
  registered_office_email          String?  @map("registered_office_email")
  authorised_capital               Decimal? @db.Decimal(20, 2) @map("authorised_capital")
  paid_up_capital                  Decimal? @db.Decimal(20, 2) @map("paid_up_capital")
  nic_industry_code                String?  @map("nic_industry_code")
  industrial_activity_description  String?  @map("industrial_activity_description")
  last_agm_date                    DateTime? @map("last_agm_date") @db.Date
  last_balance_sheet_date          DateTime? @map("last_balance_sheet_date") @db.Date
  cin_history                      String[] @default([]) @map("cin_history")

  created_at                       DateTime @default(now()) @map("created_at")
  updated_at                       DateTime @updatedAt @map("updated_at")

  directors_kmp     ParserDirectorKmp[]
  auditors          ParserAuditor[]
  resolutions       ParserResolutionAgreement[]
  deposits          ParserDeposit[]
  registrations     ParserRegistration[]
  mca_filings       ParserMcaFiling[]
  moa_clauses       ParserMoaClause[]
  aoa_clauses       ParserAoaClause[]

  @@map("parser_company")
}

model ParserDirectorKmp {
  // PK = (cin, din_or_pan) — composite per report. `din_or_pan` is whichever
  // identifier the source provides (DIN for directors, PAN for non-DIN KMP).
  cin                  String
  din_or_pan           String   @map("din_or_pan")
  din                  String?
  pan                  String?
  name                 String?
  designation          String?
  category             String?
  date_of_appointment  DateTime? @map("date_of_appointment") @db.Date
  date_of_cessation    DateTime? @map("date_of_cessation") @db.Date
  nationality          String?
  dob                  DateTime? @db.Date
  gender               String?
  father_name          String?  @map("father_name")
  address_permanent    String?  @map("address_permanent")
  address_present      String?  @map("address_present")
  email                String?
  mobile               String?
  aadhaar_last4        String?  @map("aadhaar_last4")
  passport_no          String?  @map("passport_no")
  kyc_last_filed_date  DateTime? @map("kyc_last_filed_date") @db.Date
  kyc_due_date         DateTime? @map("kyc_due_date") @db.Date

  created_at           DateTime @default(now()) @map("created_at")
  updated_at           DateTime @updatedAt @map("updated_at")

  company              ParserCompany @relation(fields: [cin], references: [cin], onDelete: Cascade)

  @@id([cin, din_or_pan])
  @@index([din])
  @@index([pan])
  @@map("parser_directors_kmp")
}

model ParserAuditor {
  // PK = (cin, frn_or_membership_no, period_from) per report. `frn_or_membership_no`
  // holds whichever ICAI key the appointment used.
  cin                       String
  frn_or_membership_no      String   @map("frn_or_membership_no")
  period_from               DateTime @map("period_from") @db.Date
  category                  String?  // 'Individual' | 'Firm'
  name                      String?
  pan                       String?
  icai_membership_no        String?  @map("icai_membership_no")
  firm_registration_no      String?  @map("firm_registration_no")
  address                   String?
  email                     String?
  date_of_appointment       DateTime? @map("date_of_appointment") @db.Date
  period_to                 DateTime? @map("period_to") @db.Date
  tenure_years              Int?     @map("tenure_years")
  appointment_type          String?  @map("appointment_type")
  agm_date                  DateTime? @map("agm_date") @db.Date
  adt1_srn                  String?  @map("adt1_srn")
  resignation_date          DateTime? @map("resignation_date") @db.Date
  resignation_reason        String?  @map("resignation_reason")
  adt3_srn                  String?  @map("adt3_srn")

  created_at                DateTime @default(now()) @map("created_at")
  updated_at                DateTime @updatedAt @map("updated_at")

  company                   ParserCompany   @relation(fields: [cin], references: [cin], onDelete: Cascade)
  adt1_filing               ParserMcaFiling? @relation("AuditorAdt1", fields: [adt1_srn], references: [srn])
  adt3_filing               ParserMcaFiling? @relation("AuditorAdt3", fields: [adt3_srn], references: [srn])

  @@id([cin, frn_or_membership_no, period_from])
  @@index([adt1_srn])
  @@index([adt3_srn])
  @@map("parser_auditors")
}

model ParserResolutionAgreement {
  // PK = (cin, mgt14_srn, sequence) per report. `sequence` is the per-resolution
  // index within a single MGT-14 filing.
  cin                String
  mgt14_srn          String   @map("mgt14_srn")
  sequence           Int
  resolution_type    String?  @map("resolution_type")
  section_under      String?  @map("section_under")
  purpose            String?
  date_passed        DateTime? @map("date_passed") @db.Date
  meeting_type       String?  @map("meeting_type")
  meeting_date       DateTime? @map("meeting_date") @db.Date
  attachment_pointer String?  @map("attachment_pointer")

  created_at         DateTime @default(now()) @map("created_at")

  company            ParserCompany   @relation(fields: [cin], references: [cin], onDelete: Cascade)
  filing             ParserMcaFiling @relation(fields: [mgt14_srn], references: [srn])

  @@id([cin, mgt14_srn, sequence])
  @@index([mgt14_srn])
  @@map("parser_resolutions_agreements")
}

model ParserDeposit {
  // PK = (cin, financial_year) per report.
  cin                       String
  financial_year            String   @map("financial_year")
  purpose_of_filing         String?  @map("purpose_of_filing")
  outstanding_secured       Decimal? @db.Decimal(20, 2) @map("outstanding_secured")
  outstanding_unsecured     Decimal? @db.Decimal(20, 2) @map("outstanding_unsecured")
  outstanding_non_deposit   Decimal? @db.Decimal(20, 2) @map("outstanding_non_deposit")
  net_worth                 Decimal? @db.Decimal(20, 2) @map("net_worth")
  credit_rating             String?  @map("credit_rating")
  dpt3_srn                  String?  @map("dpt3_srn")

  created_at                DateTime @default(now()) @map("created_at")
  updated_at                DateTime @updatedAt @map("updated_at")

  company                   ParserCompany   @relation(fields: [cin], references: [cin], onDelete: Cascade)
  filing                    ParserMcaFiling? @relation(fields: [dpt3_srn], references: [srn])

  @@id([cin, financial_year])
  @@index([dpt3_srn])
  @@map("parser_deposits")
}

model ParserRegistration {
  // PK = (cin, type, identifier) per report. One row per GSTIN per State,
  // one row for Udyam, one row for IEC, etc.
  cin                            String
  type                           String   // 'GST' | 'UDYAM' | 'IEC' | ...
  identifier                     String

  // GST sub-block
  gstin                          String?
  gst_legal_name                 String?  @map("gst_legal_name")
  gst_trade_name                 String?  @map("gst_trade_name")
  constitution_of_business       String?  @map("constitution_of_business")
  principal_place_of_business    String?  @map("principal_place_of_business")
  additional_places_of_business  String[] @default([]) @map("additional_places_of_business")
  date_of_liability              DateTime? @map("date_of_liability") @db.Date
  period_of_validity_from        DateTime? @map("period_of_validity_from") @db.Date
  period_of_validity_to          DateTime? @map("period_of_validity_to") @db.Date
  type_of_registration           String?  @map("type_of_registration")

  // Udyam sub-block
  udyam_registration_number      String?  @map("udyam_registration_number")
  udyam_enterprise_type          String?  @map("udyam_enterprise_type")
  udyam_date_of_registration     DateTime? @map("udyam_date_of_registration") @db.Date
  udyam_date_of_commencement     DateTime? @map("udyam_date_of_commencement") @db.Date
  nic_codes                      String[] @default([]) @map("nic_codes")

  created_at                     DateTime @default(now()) @map("created_at")
  updated_at                     DateTime @updatedAt @map("updated_at")

  company                        ParserCompany @relation(fields: [cin], references: [cin], onDelete: Cascade)

  @@id([cin, type, identifier])
  @@map("parser_registrations")
}

model ParserMcaFiling {
  // PK = srn per report. SRN is the universal FK across MCA tables.
  srn                    String   @id
  cin                    String
  form_type              String   @map("form_type")
  purpose                String?
  filing_date            DateTime? @map("filing_date") @db.Date
  event_date             DateTime? @map("event_date") @db.Date
  fee_paid               Decimal? @db.Decimal(20, 2) @map("fee_paid")
  additional_fee         Decimal? @db.Decimal(20, 2) @map("additional_fee")
  payment_mode           String?  @map("payment_mode")
  payment_status         String?  @map("payment_status")
  processing_status      String?  @map("processing_status")
  dsc_signatory          String?  @map("dsc_signatory")
  professional_certifier String?  @map("professional_certifier")
  attachment_list        String[] @default([]) @map("attachment_list")

  created_at             DateTime @default(now()) @map("created_at")
  updated_at             DateTime @updatedAt @map("updated_at")

  company                ParserCompany @relation(fields: [cin], references: [cin], onDelete: Cascade)
  resolutions            ParserResolutionAgreement[]
  deposits               ParserDeposit[]
  auditor_adt1_links     ParserAuditor[]              @relation("AuditorAdt1")
  auditor_adt3_links     ParserAuditor[]              @relation("AuditorAdt3")

  @@index([cin])
  @@index([form_type])
  @@map("parser_mca_filings")
}

// ===========================================================================
// Stage 2 — Group A clause-tree storage + inconsistencies log
// ---------------------------------------------------------------------------
// New tables introduced in Stage 2 to back the AoA/MoA clause-tree extractors
// and the cross-document validation outcome log. Field names follow the user's
// Stage 2 brief verbatim. Stage 1 schema is untouched.
// ===========================================================================

model ParserMoaClause {
  // Per the Stage 2 brief: columns cin, clause_roman, clause_title, clause_text,
  // sub_clauses JSONB. PK = (cin, clause_roman).
  cin           String
  clause_roman  String   @map("clause_roman")
  clause_title  String   @map("clause_title")
  clause_text   String   @map("clause_text")
  sub_clauses   Json?    @map("sub_clauses")

  created_at    DateTime @default(now()) @map("created_at")
  updated_at    DateTime @updatedAt       @map("updated_at")

  company       ParserCompany @relation(fields: [cin], references: [cin], onDelete: Cascade)

  @@id([cin, clause_roman])
  @@map("parser_moa_clauses")
}

model ParserAoaClause {
  // Per the Stage 2 brief: clause-tree keyed (cin, article_no, article_title, clause_no).
  // Sub-clauses NOT atomised — clause_text holds raw text.
  cin           String
  article_no    String   @map("article_no")
  article_title String   @map("article_title")
  clause_no     String   @map("clause_no")
  clause_text   String   @map("clause_text")

  created_at    DateTime @default(now()) @map("created_at")
  updated_at    DateTime @updatedAt       @map("updated_at")

  company       ParserCompany @relation(fields: [cin], references: [cin], onDelete: Cascade)

  @@id([cin, article_no, article_title, clause_no])
  @@map("parser_aoa_clauses")
}

model ParserInconsistency {
  // Cross-document validator outcome log. Columns per Stage 2 brief verbatim:
  // id, cin, severity, rule, source_doc_type, source_doc_id, field, expected,
  // found, created_at.
  id              String   @id @default(cuid())
  cin             String?
  severity        String
  rule            String
  source_doc_type String   @map("source_doc_type")
  source_doc_id   String?  @map("source_doc_id")
  field           String?
  expected        String?
  found           String?
  created_at      DateTime @default(now()) @map("created_at")

  @@index([cin])
  @@index([severity])
  @@map("parser_inconsistencies")
}

model AuditLog {
  id          String   @id @default(cuid())
  companyId   String?
  userId      String?
  entity      String   // e.g. "Company", "Director", "CapitalHistory"
  entityId    String?
  action      String   // "create" | "update" | "delete"
  before      Json?
  after       Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, entity, createdAt])
  @@index([userId, createdAt])
}
