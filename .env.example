# Postgres
DATABASE_URL="postgresql://akrutiwalls:akrutiwalls@localhost:5432/akrutiwalls?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# File storage
# "local" stores in ./storage. Switch to "s3" later.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# S3 (only used when STORAGE_DRIVER=s3)
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Seed admin (created by `npm run seed`)
SEED_ADMIN_EMAIL="admin@akrutiwalls.local"
SEED_ADMIN_PASSWORD="changeme123"

# ---------- Parser service (Python sidecar) ----------
# URL of the parser service. In docker-compose this is http://parser:8000.
PARSER_SERVICE_URL="http://localhost:8000"
# Optional shared secret. If set, both services must agree.
PARSER_SHARED_SECRET="change-me-parser-secret"

# Optional LLM fallback for free-text / scanned BR & EGM. Off by default — keeps
# parsing 100% local. Flip to "true" only after you've added ANTHROPIC_API_KEY.
PARSER_LLM_ENABLED="false"
PARSER_LLM_MODEL="claude-haiku-4-5"
ANTHROPIC_API_KEY=""
